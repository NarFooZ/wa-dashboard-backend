# Green API Settings
GREEN_API_INSTANCE_ID=your_instance_id_here
GREEN_API_TOKEN=your_api_token_here
GREEN_API_BASE_URL=https://api.green-api.com

# Target WhatsApp Group
GROUP_ID=120363000000000000@g.us

# Server
PORT=3001
NODE_ENV=production

# JWT Secret (change this to a random strong string)
JWT_SECRET=change_this_to_a_very_long_random_string_123456

# Super Admin credentials (only used on first run to create the account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── Dynamic settings — initial defaults only ───────────────
# After first run, these are stored in the database and managed
# from the Settings page in the dashboard. Editing these env vars
# later has NO effect unless the database is deleted.

# Confirmation keyword/emoji that triggers automatic billing
BILLING_KEYWORD=تم
BILLING_EMOJI=👍

# Keywords used to detect order type within the confirmation message
INTERNAL_KEYWORD=داخلي
EXTERNAL_KEYWORD=خارجي

# Commission amounts (JOD)
COMMISSION_INTERNAL=1
COMMISSION_EXTERNAL=2

# Security deposit (JOD) — refundable, separate from operating balance
SECURITY_DEPOSIT_AMOUNT=20

# Fixed subscription alternative to per-order commission
FIXED_SUBSCRIPTION_AMOUNT=10
FIXED_SUBSCRIPTION_PERIOD=weekly

# Compensation paid to captain if merchant cancels order without captain fault
CANCELLATION_COMPENSATION=2

# Settlement cycle text + Click transfer number + late penalty window
SETTLEMENT_SCHEDULE=يومياً عند الساعة 9 مساءً
CLICK_TRANSFER_NUMBER=0790000000
LATE_SETTLEMENT_HOURS=24
